#include <stdio.h>
#include <stdint.h>
/* ---------- Registres simulés des périphériques ---------- */
typedef struct
{
volatile uint32_t CR; // registre de contrôle
volatile uint32_t SR; // registre de statut
volatile uint32_t DR; // registre de donnée

volatile uint32_t CR; // registre de contrôle
volatile uint32_t SR; // registre de statut
volatile uint32_t DR; // registre de donnée
} 
I2C_TypeDef;

static I2C_TypeDef i2cSimule = {0};

#define I2C1 (&i2cSimule)

#define I2C_ADRESSE_PRESSION 0x76
/* ---------- États possibles d'un capteur ---------- */
typedef enum
{
CAPTEUR_OK = 0,
CAPTEUR_ERREUR
} EtatCapteur;
/* ---------- Capteur de température (ADC) ---------- */
typedef struct
{
uint8_t canal;
int16_t dernierEchantillon;
EtatCapteur etat;
} CapteurTemperature;
static CapteurTemperature temperature = {.canal = ADC_CANAL_TEMPERATURE};
static void adc_init(void)
{
ADC1->CR |= (1 << 0); // active l'ADC
}
static uint16_t adc_lire(uint8_t canal)
{
ADC1->CR = (ADC1->CR & ~0xFF00) | (canal << 8);
ADC1->CR |= (1 << 1); // démarre la conversion
// simulation d'une lecture, en pratique on attendrait ADC1->SR
return 1200 + canal * 50;
}
static void temperature_init(void)
{
temperature.canal = ADC_CANAL_TEMPERATURE;
temperature.etat = CAPTEUR_OK;
}
static float temperature_lire_celsius(void)
{
uint16_t brut = adc_lire(temperature.canal);
temperature.dernierEchantillon = (int16_t)brut;
// conversion fictive du signal brut en degrés Celsius
return (float)brut / 40.0f;
}
/* ---------- Capteur d'humidité (ADC) ---------- */
typedef struct
{
uint8_t canal;
int16_t dernierEchantillon;
EtatCapteur etat;
} CapteurHumidite;
static CapteurHumidite humidite = {.canal = ADC_CANAL_HUMIDITE};
static void humidite_init(void)
{
humidite.canal = ADC_CANAL_HUMIDITE;
humidite.etat = CAPTEUR_OK;
}
static float humidite_lire_pourcentage(void)
{
uint16_t brut = adc_lire(humidite.canal);
humidite.dernierEchantillon = (int16_t)brut;
// conversion fictive du signal brut en pourcentage d'humidité relative
float pourcentage = (float)brut / 20.0f;
if (pourcentage > 100.0f)
{
pourcentage = 100.0f;
}
return pourcentage;
}
/* ---------- Capteur de pression atmosphérique (I2C) ---------- */
typedef struct
{
uint8_t adresse;
int32_t dernierEchantillon;
EtatCapteur etat;
} CapteurPression;
static CapteurPression pression = {.adresse = I2C_ADRESSE_PRESSION};
static void i2c_init(void)
{
I2C1->CR |= (1 << 0); // active le périphérique I2C
}
static uint32_t i2c_lire_registre(uint8_t adresse)
{
I2C1->CR = (I2C1->CR & ~0xFF00) | (adresse << 8);
I2C1->CR |= (1 << 1); // démarre la transaction
// simulation d'une lecture, en pratique on attendrait I2C1->SR
return 101325;
}
static void pression_init(void)
{
pression.adresse = I2C_ADRESSE_PRESSION;
pression.etat = CAPTEUR_OK;
}
static float pression_lire_hpa(void)
{
uint32_t brut = i2c_lire_registre(pression.adresse);
pression.dernierEchantillon = (int32_t)brut;
// conversion fictive du registre brut en hectopascals
return (float)brut / 100.0f;
}
/* ---------- Programme principal ---------- */
int main(void)
{
adc_init();
i2c_init();
temperature_init();
humidite_init();
pression_init();
for (int cycle = 0; cycle < 5; cycle++)
{
float tempC = temperature_lire_celsius();
float humPct = humidite_lire_pourcentage();
float presHpa = pression_lire_hpa();
printf("Cycle %d :\n", cycle);
printf(" Temperature = %.1f C\n", tempC);
printf(" Humidite = %.1f %%\n", humPct);
printf(" Pression = %.1f hPa\n", presHpa);
}
return 0;
}